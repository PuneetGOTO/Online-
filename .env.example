# Discord Bot Token
DISCORD_TOKEN=

# 最高權限：唯一能核准目標、設定上限、使用 override 的人
OWNER_ID=

# 安全人員 ID，逗號分隔。可提交目標、驗證所有權、在核准範圍內發起壓測
# （壓測執行仍需 OWNER 按鈕核准）
STAFF_IDS=

# 填入伺服器 ID 可讓斜線指令立即生效
GUILD_ID=

# 控制平面所在機器的 JMeter 執行檔（master 也需要 JMeter）
# Windows 範例：E:\Coding\網絡安全\apache-jmeter-5.6.3\apache-jmeter-5.6.3\bin\jmeter.bat
# Ubuntu 範例：/opt/jmeter/bin/jmeter
JMETER_BIN=jmeter

# ---------------------------------------------------------------- Web 控制台
# 存取權杖。留空則首次啟動自動生成並寫入專案根目錄的 .web_token
WEB_TOKEN=

# 控制台監聽埠
WEB_PORT=8080

# 控制台部署節點時使用的 SSH 帳號
SSH_USER=root

# 主服務器對外 IP（留空自動偵測）。節點部署時會以此寫入防火牆白名單
MASTER_IP=
